# conf/tier1_settings.conf (DATA_DIR) if overridden for a real deployment.
/tier1exclusions/output/

# Default log location (failure marker) — derived from DATA_DIR in
# conf/tier1_settings.conf, not source.
/tier1exclusions/logs/

